# ---------------------------------------------------------------------------
# Kayar — environment configuration
# Copy to .env and fill in the values. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- database (required) --------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_POOL_MAX=10

# --- api ------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public base URL of the installation (used for media links)
PUBLIC_BASE_URL=http://localhost:3000
# Extra browser origins that may call the API (comma separated)
ALLOWED_ORIGINS=
# Set to false only when you run the site over plain HTTP locally
COOKIE_SECURE=false
LOG_LEVEL=info

# --- first superadmin (only used when no superadmin exists yet) -----------
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- password hashing -----------------------------------------------------
# Optional pepper. WARNING: do not change it after the first account is created,
# otherwise the existing password hashes can no longer be verified.
AUTH_PEPPER=

# --- jamendo (optional) ---------------------------------------------------
# Client id of the Jamendo developer account (server side only)
JAMENDO_CLIENT_ID=

# --- AI: NaraRouter (optional) -------------------------------------------
# The key is only read on the server. It is never sent to the browser.
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=https://router.bynara.id/v1
# Comma separated list: the first model is primary, the rest are fallbacks
NARAROUTER_MODELS=agnes-2.5-flash,laguna-s-2.1,nemotron-3.5-lightning-free
NARAROUTER_TIMEOUT_MS=60000

# --- bodyyar quotas --------------------------------------------------------
BODYYAR_PLAN_DAILY_LIMIT=5
BODYYAR_CHAT_DAILY_LIMIT=40
BODYYAR_CHAT_RATE_PER_MINUTE=12

# --- media storage --------------------------------------------------------
# local | s3
MEDIA_STORAGE=local
MEDIA_DIR=./storage/uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BASE_PATH=
# S3_PUBLIC_URL=
