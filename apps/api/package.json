{
  "name": "@kayar/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/main.js",
    "dev": "node --env-file=../../.env --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "seed": "node dist/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@kayar/shared": "*",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.7",
    "pg": "8.20.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/pg": "8.18.0",
    "drizzle-kit": "0.31.10",
    "typescript": "5.7.3",
    "vitest": "5.0.5"
  }
}
