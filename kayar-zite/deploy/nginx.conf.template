# Rendered by the nginx image at start-up: ${BACKEND_HOST} comes from the Liara env var BACKEND_HOST.
# BACKEND_HOST = the KAYAR backend host only (no https://, no slash), e.g. ma8nxe5agt.zite.so or api.kapoosh.ir

upstream kayar_backend {
  server ${BACKEND_HOST}:443 max_fails=0;
  keepalive 32;
  keepalive_timeout 60s;
}

proxy_cache_path /var/cache/nginx/kayar levels=1:2 keys_zone=kayar_pub:10m max_size=200m inactive=30d use_temp_path=off;

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 50m;
  client_body_buffer_size 1m;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/manifest+json;
  gzip_min_length 1024;
  gzip_comp_level 6;
  gzip_vary on;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options SAMEORIGIN always;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host ${BACKEND_HOST};
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_ssl_server_name on;
  proxy_ssl_name ${BACKEND_HOST};
  proxy_ssl_protocols TLSv1.2 TLSv1.3;
  proxy_ssl_session_reuse on;
  proxy_connect_timeout 8s;
  proxy_send_timeout 60s;
  proxy_next_upstream error timeout http_502 http_503 http_504;
  proxy_next_upstream_tries 3;
  proxy_next_upstream_timeout 25s;

  location ~ ^/api/(publicCms|publicSettings|publicPosts)$ {
    proxy_pass https://kayar_backend;
    proxy_cache kayar_pub;
    proxy_cache_methods POST GET;
    proxy_cache_key "$uri|$request_body";
    proxy_cache_valid 200 2m;
    proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_ignore_headers Cache-Control Expires Set-Cookie Vary;
    proxy_hide_header Set-Cookie;
    proxy_read_timeout 30s;
    add_header X-Cache $upstream_cache_status always;
  }

  location /api/ {
    proxy_pass https://kayar_backend;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 180s;
  }

  location = /__backend {
    proxy_pass https://kayar_backend/api/publicSettings;
    proxy_method POST;
    proxy_set_header Content-Type application/json;
    proxy_set_body "{}";
    proxy_read_timeout 20s;
  }

  location ^~ /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
  location = /healthz { access_log off; return 200 'ok'; }
  location = /manifest.webmanifest { types { application/manifest+json webmanifest; } add_header Cache-Control "public, max-age=86400"; }
  location ^~ /media/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
  location ~* \.(png|svg|ico|jpg|jpeg|gif|webp|woff2?)$ { expires 30d; add_header Cache-Control "public"; try_files $uri =404; }
  location / { add_header Cache-Control "no-cache"; try_files $uri $uri/ /index.html; }
  location ~ /\.well-known { allow all; }
}
