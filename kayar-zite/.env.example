# Copy to .env for local runs. Never commit real values.
DATABASE_URL=postgres://user:password@localhost:5432/kayar
PUBLIC_URL=http://localhost:3000
PORT=3000
UPLOAD_DIR=/data/uploads
UPLOAD_LIMIT=
DB_POOL_SIZE=
ZITE_BOOTSTRAP_ADMIN_USERNAME=
ZITE_BOOTSTRAP_ADMIN_PASSWORD=   # min 10 chars; you must change it on first login
ZITE_AUTH_PEPPER=
ZITE_NARAROUTER_API_KEY=
# Optional
ZITE_SMS_PROVIDER=
ZITE_SMS_API_KEY=
ZITE_SMS_SENDER=
ZITE_ZARINPAL_MERCHANT_ID=
ZITE_ZARINPAL_SANDBOX=
# Optional hardening / ops (all have safe defaults)
HEALTH_TOKEN=
ALERT_WEBHOOK_URL=
UPLOAD_MAX_TOTAL_MB=
UPLOAD_MEMBER_MAX_MB=
UPLOAD_MEMBER_DAILY_MB=
UPLOAD_MEMBER_DAILY_FILES=
RL_UPLOAD_PER_MIN=
RL_API_PER_MIN=
RL_PUBLIC_PER_MIN=
RL_LOGIN_PER_MIN=
RL_LOGIN_PER_15MIN=
RL_SMS_PER_HOUR=
RL_CAMPAIGN_ACTIONS_PER_HOUR=
RATE_LIMIT_DISABLED=
AI_DAILY_LIMIT=
AI_TIMEOUT_MS=
API_BODY_LIMIT=
TRUST_PROXY=
CSP_ENFORCE=
ERROR_LOG_CAP=
SW_DISABLED=
